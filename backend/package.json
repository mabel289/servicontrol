{
  "name": "servicontrol-backend",
  "version": "1.0.0",
  "description": "API REST modular para el sistema de gestión ServiControl",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "seed": "node --env-file=.env prisma/seed.js"
  },
  "prisma": {
    "seed": "node --env-file=.env prisma/seed.js"
  },
  "keywords": [
    "servicontrol",
    "express",
    "api-rest",
    "modular",
    "poo"
  ],
  "author": "ServiControl Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
